+static HRESULT copy_folder_item(FolderImpl *destination, FolderItem *item, DWORD flags)
+{
+    SHFILEOPSTRUCTW operation = {0};
+    WCHAR *source, *target;
+    BSTR path;
+    HRESULT hr;
+    int result;
+
+    if (item->lpVtbl == (const FolderItemVtbl *)&FolderItemImpl_Vtbl)
+    {
+        FolderItemImpl *impl = impl_from_FolderItem((FolderItem2 *)item);
+        if (impl->folder->zip)
+            return shell_zip_copy(impl->folder->zip, impl->path
+                    ? impl->path + SysStringLen(impl->folder->path) + 1 : NULL, destination->path, flags);
+    }
+    if (FAILED(hr = FolderItem_get_Path(item, &path))) return hr;
+    source = calloc(SysStringLen(path) + 2, sizeof(WCHAR));
+    target = calloc(SysStringLen(destination->path) + 2, sizeof(WCHAR));
+    if (!source || !target)
+    {
+        free(source);
+        free(target);
+        SysFreeString(path);
+        return E_OUTOFMEMORY;
+    }
+    wcscpy(source, path);
+    wcscpy(target, destination->path);
+    SysFreeString(path);
+    operation.wFunc = FO_COPY;
+    operation.pFrom = source;
+    operation.pTo = target;
+    operation.fFlags = flags;
+    result = SHFileOperationW(&operation);
+    free(source);
+    free(target);
+    return result ? HRESULT_FROM_WIN32(result) : operation.fAnyOperationsAborted
+            ? HRESULT_FROM_WIN32(ERROR_CANCELLED) : S_OK;
+}
