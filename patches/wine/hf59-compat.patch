+static HRESULT zip_folder_constructor(const WCHAR *path, Folder **ret)
+{
+    FolderImpl *folder;
+    HRESULT hr;
+
+    if (!(folder = calloc(1, sizeof(*folder)))) return E_OUTOFMEMORY;
+    if ((hr = shell_zip_open(path, &folder->zip)) != S_OK)
+    {
+        free(folder);
+        return hr;
+    }
+    folder->Folder3_iface.lpVtbl = &FolderImpl_Vtbl;
+    folder->ref = 1;
+    folder->path = SysAllocString(path);
+    hr = IShellDispatch_Constructor(NULL, &IID_IDispatch, (void **)&folder->application);
+    if (!folder->path || FAILED(hr))
+    {
+        shell_zip_close(folder->zip);
+        SysFreeString(folder->path);
+        if (folder->application) IDispatch_Release(folder->application);
+        free(folder);
+        return FAILED(hr) ? hr : E_OUTOFMEMORY;
+    }
+    *ret = (Folder *)&folder->Folder3_iface;
+    return S_OK;
+}
