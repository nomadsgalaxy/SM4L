+ * Lesser General Public License for more details.
+ */
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "oleauto.h"
+#include "shlobj.h"
+#include "shellapi.h"
+#include "shlwapi.h"
+#include "zlib.h"
+#include "zipfolder.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(zip);
+
+struct zip_entry
+{
+    WCHAR *name;
+    const BYTE *header;
+    DWORD offset, compressed, size, crc;
+    WORD method;
+};
+
+struct shell_zip
+{
+    const BYTE *data;
+    DWORD directory;
+    unsigned int count;
+    struct zip_entry *entries;
+};
+
+static WORD zip_word(const BYTE *p)
+{
+    return p[0] | (p[1] << 8);
+}
+
+static DWORD zip_dword(const BYTE *p)
+{
+    return zip_word(p) | ((DWORD)zip_word(p + 2) << 16);
+}
+
+/* Win32 normalizes these names, so reject them before building a destination path. */
+static BOOL zip_safe_name(WCHAR *name)
+{
+    WCHAR *p, *component = name;
+    unsigned int length, base;
+
+    if (!*name || *name == '/' || *name == '\\') return FALSE;
+    for (p = name;; p++)
+    {
+        if (*p == '/') *p = '\\';
+        if (*p && *p != '\\')
+        {
+            if (*p < 32 || wcschr(L":*?\"<>|", *p)) return FALSE;
+            continue;
+        }
+        length = p - component;
+        if (!length || component[length - 1] == '.' || component[length - 1] == ' ') return FALSE;
+        for (base = 0; base < length && component[base] != '.'; base++);
+        if (base == 3 && (!wcsnicmp(component, L"CON", 3) || !wcsnicmp(component, L"PRN", 3)
+                || !wcsnicmp(component, L"AUX", 3) || !wcsnicmp(component, L"NUL", 3))) return FALSE;
+        if (base == 4 && component[3] >= '1' && component[3] <= '9'
+                && (!wcsnicmp(component, L"COM", 3) || !wcsnicmp(component, L"LPT", 3))) return FALSE;
+        if (!*p || !p[1]) break;
+        component = p + 1;
+    }
+    return TRUE;
+}
+
+void shell_zip_close(struct shell_zip *zip)
+{
+    unsigned int i;
+
+    if (!zip) return;
+    for (i = 0; i < zip->count; i++) free(zip->entries[i].name);
+    free(zip->entries);
+    if (zip->data) UnmapViewOfFile(zip->data);
+    free(zip);
+}
+
+HRESULT shell_zip_open(const WCHAR *path, struct shell_zip **ret)
+{
+    HANDLE file, mapping;
+    LARGE_INTEGER size;
+    struct shell_zip *zip;
+    const BYTE *end, *p, *limit;
+    DWORD position, minimum, length;
+    unsigned int i;
+    HRESULT hr = S_FALSE;
+
+    *ret = NULL;
+    TRACE("Opening %s\n", debugstr_w(path));
+    if (!(zip = calloc(1, sizeof(*zip)))) return E_OUTOFMEMORY;
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) goto failed;
+    if (!GetFileSizeEx(file, &size) || size.QuadPart < 22 || size.QuadPart >= 0xffffffff)
+    {
+        CloseHandle(file);
+        goto failed;
+    }
+    mapping = CreateFileMappingW(file, NULL, PAGE_READONLY, 0, 0, NULL);
+    CloseHandle(file);
+    if (!mapping) goto failed;
+    zip->data = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0);
+    CloseHandle(mapping);
+    if (!zip->data) goto failed;
+    position = size.LowPart - 22;
+    minimum = size.LowPart > 65557 ? size.LowPart - 65557 : 0;
+    for (;; position--)
+    {
+        end = zip->data + position;
+        if (zip_dword(end) == 0x06054b50 && position + 22 + zip_word(end + 20) == size.LowPart) break;
+        if (position == minimum) goto failed;
+    }
+    /* shortcut: classic single-disk ZIP only; add ZIP64 when a caller needs archives over 4 GB. */
+    if (zip_word(end + 4) || zip_word(end + 6) || zip_word(end + 8) != zip_word(end + 10)
+            || zip_word(end + 10) == 0xffff) goto failed;
+    zip->directory = zip_dword(end + 16);
+    length = zip_dword(end + 12);
+    if (zip->directory > position || length != position - zip->directory) goto failed;
+    zip->count = zip_word(end + 10);
+    if (zip->count && !(zip->entries = calloc(zip->count, sizeof(*zip->entries))))
+    {
+        zip->count = 0;
+        hr = E_OUTOFMEMORY;
+        goto failed;
+    }
+    p = zip->data + zip->directory;
+    limit = p + length;
+    for (i = 0; i < zip->count; i++)
+    {
+        struct zip_entry *entry = &zip->entries[i];
+        WORD flags, name_length;
+        int chars;
+
+        if (limit - p < 46 || zip_dword(p) != 0x02014b50) goto failed;
+        flags = zip_word(p + 8);
+        name_length = zip_word(p + 28);
+        length = 46 + name_length + zip_word(p + 30) + zip_word(p + 32);
+        if (length > limit - p || !name_length || memchr(p + 46, 0, name_length)
+                || flags & (1 | 0x40 | 0x2000) || zip_word(p + 34)
+                || (zip_dword(p + 38) >> 16 & 0170000) == 0120000) goto failed;
+        entry->header = p;
+        entry->method = zip_word(p + 10);
+        entry->crc = zip_dword(p + 16);
+        entry->compressed = zip_dword(p + 20);
+        entry->size = zip_dword(p + 24);
+        entry->offset = zip_dword(p + 42);
+        if ((entry->method != 0 && entry->method != 8) || entry->offset >= zip->directory
+                || entry->compressed == 0xffffffff || entry->size == 0xffffffff) goto failed;
+        chars = MultiByteToWideChar(flags & 0x800 ? CP_UTF8 : 437, MB_ERR_INVALID_CHARS,
+                (const char *)p + 46, name_length, NULL, 0);
+        if (!chars)
+        {
+            WARN("Failed to decode ZIP filename, error %lu\n", GetLastError());
+            goto failed;
+        }
+        if (!(entry->name = malloc((chars + 1) * sizeof(WCHAR))))
+        {
+            hr = E_OUTOFMEMORY;
+            goto failed;
+        }
+        MultiByteToWideChar(flags & 0x800 ? CP_UTF8 : 437, MB_ERR_INVALID_CHARS,
+                (const char *)p + 46, name_length, entry->name, chars);
+        entry->name[chars] = 0;
+        if (!zip_safe_name(entry->name)) goto failed;
+        p += length;
+    }
+    if (p != limit) goto failed;
+    *ret = zip;
+    return S_OK;
+
+failed:
+    WARN("Failed to open ZIP %s, hr %#lx\n", debugstr_w(path), hr);
+    shell_zip_close(zip);
+    return hr;
+}
+
+HRESULT shell_zip_names(struct shell_zip *zip, BSTR **names, LONG *count)
+{
+    unsigned int i, j, length;
+    const WCHAR *slash;
+
+    *count = 0;
+    *names = NULL;
+    if (zip->count && !(*names = calloc(zip->count, sizeof(**names)))) return E_OUTOFMEMORY;
+    for (i = 0; i < zip->count; i++)
+    {
+        slash = wcschr(zip->entries[i].name, '\\');
+        length = slash ? slash - zip->entries[i].name : wcslen(zip->entries[i].name);
+        for (j = 0; j < *count; j++)
+            if (SysStringLen((*names)[j]) == length && !wcsnicmp((*names)[j], zip->entries[i].name, length)) break;
+        if (j < *count) continue;
+        if (!((*names)[*count] = SysAllocStringLen(zip->entries[i].name, length))) return E_OUTOFMEMORY;
+        (*count)++;
+    }
+    return S_OK;
+}
+
+DWORD shell_zip_attributes(struct shell_zip *zip, const WCHAR *name)
+{
+    unsigned int i, length = wcslen(name);
+
+    for (i = 0; i < zip->count; i++)
+    {
+        const WCHAR *entry = zip->entries[i].name;
+        if (!wcsnicmp(entry, name, length))
+        {
+            if (entry[length] == '\\') return SFGAO_FOLDER | SFGAO_BROWSABLE;
+            if (!entry[length]) return SFGAO_CANCOPY;
+        }
+    }
+    return 0;
+}
+
+static HRESULT zip_directory(WCHAR *path)
+{
+    DWORD attributes;
+
+    if (!CreateDirectoryW(path, NULL) && GetLastError() != ERROR_ALREADY_EXISTS)
+        return HRESULT_FROM_WIN32(GetLastError());
+    attributes = GetFileAttributesW(path);
+    if (attributes == INVALID_FILE_ATTRIBUTES) return HRESULT_FROM_WIN32(GetLastError());
+    if (!(attributes & FILE_ATTRIBUTE_DIRECTORY) || attributes & FILE_ATTRIBUTE_REPARSE_POINT)
+        return HRESULT_FROM_WIN32(ERROR_ACCESS_DENIED);
+    return S_OK;
+}
+
+static void *zip_alloc(void *opaque, unsigned int count, unsigned int size)
+{
+    return calloc(count, size);
+}
+
+static void zip_free(void *opaque, void *address)
+{
+    free(address);
+}
+
+static HRESULT zip_extract(struct shell_zip *zip, struct zip_entry *entry, const WCHAR *destination, DWORD flags)
+{
+    WCHAR path[MAX_PATH], temporary[MAX_PATH], *p;
+    BYTE buffer[65536];
+    const BYTE *header, *data;
+    DWORD offset, written, attributes;
+    unsigned int length, root, produced;
+    HANDLE file;
+    z_stream stream = {.zalloc = zip_alloc, .zfree = zip_free};
+    ULONG crc = crc32(0, NULL, 0);
+    HRESULT hr;
+    int status;
+
+    root = wcslen(destination);
+    length = wcslen(entry->name);
+    if (root + 1 + length >= ARRAY_SIZE(path)) return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    wcscpy(path, destination);
+    if (path[root - 1] != '\\') path[root++] = '\\';
+    wcscpy(path + root, entry->name);
+    for (p = path + root; *p; p++)
+    {
+        if (*p != '\\') continue;
+        *p = 0;
+        hr = zip_directory(path);
+        *p = '\\';
+        if (FAILED(hr)) return hr;
+    }
+    if (path[wcslen(path) - 1] == '\\') return S_OK;
+    attributes = GetFileAttributesW(path);
+    if (attributes != INVALID_FILE_ATTRIBUTES && attributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY))
+        return HRESULT_FROM_WIN32(ERROR_ACCESS_DENIED);
+    if (entry->offset > zip->directory || zip->directory - entry->offset < 30)
+        return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    header = zip->data + entry->offset;
+    if (zip_dword(header) != 0x04034b50 || zip_word(header + 8) != entry->method
+            || zip_word(header + 6) != zip_word(entry->header + 8)
+            || zip_word(header + 26) != zip_word(entry->header + 28))
+        return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    offset = 30 + zip_word(header + 26) + zip_word(header + 28);
+    if (offset > zip->directory - entry->offset
+            || entry->compressed > zip->directory - entry->offset - offset
+            || memcmp(header + 30, entry->header + 46, zip_word(header + 26)))
+        return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    data = header + offset;
+    p = wcsrchr(path, '\\');
+    *p = 0;
+    status = GetTempFileNameW(path, L"zip", 0, temporary);
+    *p = '\\';
+    if (!status) return HRESULT_FROM_WIN32(GetLastError());
+    file = CreateFileW(temporary, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        DeleteFileW(temporary);
+        return hr;
+    }
+    stream.next_in = (BYTE *)data;
+    stream.avail_in = entry->compressed;
+    hr = S_OK;
+    if (entry->method == 8 && inflateInit2(&stream, -MAX_WBITS) != Z_OK) hr = E_FAIL;
+    else
+    {
+        do
+        {
+            if (entry->method == 8)
+            {
+                stream.next_out = buffer;
+                stream.avail_out = sizeof(buffer);
+                status = inflate(&stream, Z_NO_FLUSH);
+                produced = sizeof(buffer) - stream.avail_out;
+            }
+            else
+            {
+                produced = min(stream.avail_in, sizeof(buffer));
+                memcpy(buffer, stream.next_in, produced);
+                stream.next_in += produced;
+                stream.avail_in -= produced;
+                stream.total_in += produced;
+                stream.total_out += produced;
+                status = stream.avail_in ? Z_OK : Z_STREAM_END;
+            }
+            if ((status != Z_OK && status != Z_STREAM_END) || stream.total_out > entry->size)
+            {
+                hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+                break;
+            }
+            crc = crc32(crc, buffer, produced);
+            if (!WriteFile(file, buffer, produced, &written, NULL)) hr = HRESULT_FROM_WIN32(GetLastError());
+            else if (written != produced) hr = HRESULT_FROM_WIN32(ERROR_WRITE_FAULT);
+        } while (SUCCEEDED(hr) && status != Z_STREAM_END);
+        if (SUCCEEDED(hr) && (stream.total_out != entry->size || stream.total_in != entry->compressed || crc != entry->crc))
+            hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+        if (entry->method == 8) inflateEnd(&stream);
+    }
+    if (!CloseHandle(file) && SUCCEEDED(hr)) hr = HRESULT_FROM_WIN32(GetLastError());
+    if (SUCCEEDED(hr) && !MoveFileExW(temporary, path, flags & FOF_NOCONFIRMATION ? MOVEFILE_REPLACE_EXISTING : 0))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    if (FAILED(hr)) DeleteFileW(temporary);
+    return hr;
+}
+
+HRESULT shell_zip_copy(struct shell_zip *zip, const WCHAR *name, const WCHAR *destination, DWORD flags)
+{
+    DWORD attributes;
+    unsigned int i, length = name ? wcslen(name) : 0;
+    HRESULT hr;
+
+    if (!*destination || PathIsRelativeW(destination)) return E_INVALIDARG;
+    attributes = GetFileAttributesW(destination);
+    if (attributes == INVALID_FILE_ATTRIBUTES || !(attributes & FILE_ATTRIBUTE_DIRECTORY)
+            || attributes & FILE_ATTRIBUTE_REPARSE_POINT) return HRESULT_FROM_WIN32(ERROR_ACCESS_DENIED);
+    for (i = 0; i < zip->count; i++)
+    {
+        const WCHAR *entry = zip->entries[i].name;
+        if (name && (wcsnicmp(entry, name, length) || (entry[length] && entry[length] != '\\'))) continue;
+        if (FAILED(hr = zip_extract(zip, &zip->entries[i], destination, flags))) return hr;
+    }
+    return S_OK;
+}
