+/***********************************************************************
+ *           InternetSetCookieEx2 (WININET.@)
+ *
+ * Sets a cookie described by an INTERNET_COOKIE2 structure for the specified url.
+ */
+DWORD WINAPI InternetSetCookieEx2(const WCHAR *url, const INTERNET_COOKIE2 *cookie, const WCHAR *p3p_policy,
+        DWORD flags, DWORD *cookie_state)
+{
+    WCHAR expires[INTERNET_RFC1123_BUFSIZE];
+    substr_t host, path;
+    DWORD state, set_flags;
+    WCHAR *data;
+    size_t len;
+
+    TRACE("(%s, %p, %s, %lx, %p)\n", debugstr_w(url), cookie, debugstr_w(p3p_policy), flags, cookie_state);
+
+    if (cookie_state)
+        *cookie_state = COOKIE_STATE_UNKNOWN;
+    if (!url || !cookie || !cookie->pwszName)
+        return ERROR_INVALID_PARAMETER;
+    if (p3p_policy)
+        FIXME("P3P policy %s ignored\n", debugstr_w(p3p_policy));
+    if (flags & ~INTERNET_COOKIE_HTTPONLY)
+        FIXME("flags %lx not supported\n", flags);
+    if (cookie->dwFlags & ~(INTERNET_COOKIE_IS_SECURE | INTERNET_COOKIE_HTTPONLY))
+        FIXME("cookie flags %lx not supported\n", cookie->dwFlags);
+
+    if (!cookie_parse_url(url, &host, &path) || !host.len)
+        return ERROR_INVALID_PARAMETER;
+
+    if (cookie->fExpiresSet)
+    {
+        SYSTEMTIME st;
+
+        if (!FileTimeToSystemTime(&cookie->ftExpires, &st)
+                || !InternetTimeFromSystemTimeW(&st, INTERNET_RFC1123_FORMAT, expires, sizeof(expires)))
+            return ERROR_INVALID_PARAMETER;
+    }
+
+    /* Express the structure as a cookie string, so it gets the same parsing and domain checks as InternetSetCookieExW. */
+    len = (cookie->pwszValue ? wcslen(cookie->pwszValue) : 0) + 1;
+    if (cookie->pwszDomain)
+        len += ARRAY_SIZE(L"; domain=") + wcslen(cookie->pwszDomain);
+    if (cookie->pwszPath)
+        len += ARRAY_SIZE(L"; path=") + wcslen(cookie->pwszPath);
+    if (cookie->fExpiresSet)
+        len += ARRAY_SIZE(L"; expires=") + wcslen(expires);
+    len += ARRAY_SIZE(L"; secure") + ARRAY_SIZE(L"; httponly");
+    if (!(data = malloc(len * sizeof(WCHAR))))
+        return ERROR_NOT_ENOUGH_MEMORY;
+
+    wcscpy(data, cookie->pwszValue ? cookie->pwszValue : L"");
+    if (cookie->pwszDomain)
+    {
+        wcscat(data, L"; domain=");
+        wcscat(data, cookie->pwszDomain);
+    }
+    if (cookie->pwszPath)
+    {
+        wcscat(data, L"; path=");
+        wcscat(data, cookie->pwszPath);
+    }
+    if (cookie->dwFlags & INTERNET_COOKIE_IS_SECURE)
+        wcscat(data, L"; secure");
+    if (cookie->dwFlags & INTERNET_COOKIE_HTTPONLY)
+        wcscat(data, L"; httponly");
+    /* last: set_cookie copies everything after "expires=" into a fixed buffer */
+    if (cookie->fExpiresSet)
+    {
+        wcscat(data, L"; expires=");
+        wcscat(data, expires);
+    }
+
+    /* The structure marking the cookie HTTP-only is the caller's consent to store it as such. */
+    set_flags = (flags | cookie->dwFlags) & INTERNET_COOKIE_HTTPONLY;
+    state = set_cookie(host, path, substrz(cookie->pwszName), substrz(data), set_flags);
+    free(data);
+
+    if (cookie_state)
+        *cookie_state = state;
+    return state == COOKIE_STATE_ACCEPT ? ERROR_SUCCESS : ERROR_INVALID_OPERATION;
+}
+
