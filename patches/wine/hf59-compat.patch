+static void write_zip_fixture(const WCHAR *path, const BYTE *data, DWORD size)
+{
+    HANDLE file;
+    DWORD written;
+
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "Failed to create fixture: %lu\n", GetLastError());
+    if (file == INVALID_HANDLE_VALUE) return;
+    ok(WriteFile(file, data, size, &written, NULL) && written == size, "Failed to write fixture\n");
+    CloseHandle(file);
+}
+
+static void check_zip_file(const WCHAR *path, const char *expected)
+{
+    HANDLE file = INVALID_HANDLE_VALUE;
+    char buffer[32];
+    DWORD read;
+    unsigned int i;
+
+    /* CopyHere may complete asynchronously on Windows. */
+    for (i = 0; i < 50 && file == INVALID_HANDLE_VALUE; i++)
+    {
+        file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+        if (file == INVALID_HANDLE_VALUE) Sleep(100);
+    }
+    ok(file != INVALID_HANDLE_VALUE, "Missing extracted file %s\n", wine_dbgstr_w(path));
+    if (file == INVALID_HANDLE_VALUE) return;
+    ok(ReadFile(file, buffer, sizeof(buffer), &read, NULL), "Failed to read extracted file\n");
+    ok(read == strlen(expected) && !memcmp(buffer, expected, read), "Unexpected extracted contents\n");
+    CloseHandle(file);
+}
