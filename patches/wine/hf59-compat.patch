+    check_zip_file(path, "stored\n");
+    swprintf(path, ARRAY_SIZE(path), L"%s\\dir\\file.txt", destination);
+    check_zip_file(path, "deflated\n");
+    variant_set_string(&index, L"root.txt");
+    hr = FolderItems_Item(items, index, &item);
+    VariantClear(&index);
+    ok(hr == S_OK, "Missing root file: %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        hr = FolderItem_get_Name(item, &name);
+        ok(hr == S_OK && !wcscmp(name, L"root.txt"), "Unexpected item name\n");
+        SysFreeString(name);
+        swprintf(path, ARRAY_SIZE(path), L"%s\\root.txt", destination);
+        DeleteFileW(path);
+        V_DISPATCH(&value) = (IDispatch *)item;
+        hr = Folder_CopyHere(target, value, options);
+        ok(hr == S_OK, "CopyHere(item) failed: %#lx\n", hr);
+        check_zip_file(path, "stored\n");
+        FolderItem_Release(item);
+    }
+    FolderItems_Release(items);
+    Folder_Release(archive);
+
+    memcpy(bad, fixture, sizeof(bad));
+    bad[38] ^= 1;
+    write_zip_fixture(zip_path, bad, sizeof(bad));
+    variant_set_string(&value, zip_path);
+    hr = IShellDispatch_NameSpace(shell, value, &archive);
+    VariantClear(&value);
+    if (hr == S_OK)
+    {
+        hr = Folder_Items(archive, &items);
+        if (hr == S_OK)
+        {
+            V_VT(&value) = VT_DISPATCH;
+            V_DISPATCH(&value) = (IDispatch *)items;
+            Folder_CopyHere(target, value, options);
+            FolderItems_Release(items);
+        }
+        Folder_Release(archive);
+    }
+    swprintf(path, ARRAY_SIZE(path), L"%s\\root.txt", destination);
+    check_zip_file(path, "stored\n");
+
+    memcpy(bad, fixture, sizeof(bad));
+    for (i = 0; i + 12 <= sizeof(bad); i++)
+        if (!memcmp(bad + i, "dir/file.txt", 12)) memcpy(bad + i, "../evil_.txt", 12);
+    write_zip_fixture(zip_path, bad, sizeof(bad));
+    variant_set_string(&value, zip_path);
+    hr = IShellDispatch_NameSpace(shell, value, &archive);
+    VariantClear(&value);
+    ok(hr == S_FALSE && !archive, "Unsafe ZIP should be rejected, got %#lx\n", hr);
+    if (hr == S_OK) Folder_Release(archive);
+
+    write_zip_fixture(zip_path, fixture, sizeof(fixture) - 10);
+    variant_set_string(&value, zip_path);
+    hr = IShellDispatch_NameSpace(shell, value, &archive);
+    VariantClear(&value);
+    ok(hr == S_FALSE && !archive, "Truncated ZIP should be rejected, got %#lx\n", hr);
+    if (hr == S_OK) Folder_Release(archive);
+
+    write_zip_fixture(zip_path, empty, sizeof(empty));
+    variant_set_string(&value, zip_path);
+    hr = IShellDispatch_NameSpace(shell, value, &archive);
+    VariantClear(&value);
+    ok(hr == S_OK, "Failed to open empty ZIP: %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        hr = Folder_Items(archive, &items);
+        ok(hr == S_OK, "Failed to enumerate empty ZIP: %#lx\n", hr);
+        if (hr == S_OK)
+        {
+            FolderItems_get_Count(items, &count);
+            ok(count == 0, "Empty ZIP contains %ld items\n", count);
+            FolderItems_Release(items);
+        }
+        Folder_Release(archive);
+    }
+    goto release_target;
+
+release_archive:
+    Folder_Release(archive);
+release_target:
+    Folder_Release(target);
+cleanup:
+    swprintf(path, ARRAY_SIZE(path), L"%s\\dir\\file.txt", destination);
+    DeleteFileW(path);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\dir", destination);
+    RemoveDirectoryW(path);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\root.txt", destination);
+    DeleteFileW(path);
+    RemoveDirectoryW(destination);
+    DeleteFileW(zip_path);
+    RemoveDirectoryW(root);
+    IShellDispatch_Release(shell);
+}
