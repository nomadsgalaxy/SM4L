+static void test_InternetSetCookieEx2(void)
+{
+    DWORD (WINAPI *pInternetSetCookieEx2)(const WCHAR *, const INTERNET_COOKIE2 *, const WCHAR *, DWORD, DWORD *);
+    INTERNET_COOKIE2 cookie = { 0 };
+    SYSTEMTIME st;
+    char buf[100];
+    DWORD size, state, res;
+    BOOL ret;
+
+    pInternetSetCookieEx2 = (void *)GetProcAddress(GetModuleHandleA("wininet.dll"), "InternetSetCookieEx2");
+    if (!pInternetSetCookieEx2)
+    {
+        win_skip("InternetSetCookieEx2 is not available.\n");
+        return;
+    }
+
+    res = pInternetSetCookieEx2(NULL, &cookie, NULL, 0, &state);
+    ok(res == ERROR_INVALID_PARAMETER, "got %lu\n", res);
+    res = pInternetSetCookieEx2(L"http://cookie.ex2.com/", NULL, NULL, 0, &state);
+    ok(res == ERROR_INVALID_PARAMETER, "got %lu\n", res);
+
+    /* session cookie */
+    cookie.pwszName = (WCHAR *)L"A";
+    cookie.pwszValue = (WCHAR *)L"one";
+    state = 0xdeadbeef;
+    res = pInternetSetCookieEx2(L"http://cookie.ex2.com/bar", &cookie, NULL, 0, &state);
+    ok(res == ERROR_SUCCESS, "got %lu\n", res);
+    ok(state == COOKIE_STATE_ACCEPT, "state %lu\n", state);
+    size = sizeof(buf);
+    ret = InternetGetCookieA("http://cookie.ex2.com/bar", NULL, buf, &size);
+    ok(ret, "InternetGetCookie failed: %lu\n", GetLastError());
+    ok(!strcmp(buf, "A=one"), "data = %s\n", buf);
+
+    /* domain and path attributes */
+    cookie.pwszName = (WCHAR *)L"B";
+    cookie.pwszValue = (WCHAR *)L"two";
+    cookie.pwszDomain = (WCHAR *)L".ex2.com";
+    cookie.pwszPath = (WCHAR *)L"/only";
+    res = pInternetSetCookieEx2(L"http://cookie.ex2.com/", &cookie, NULL, 0, NULL);
+    ok(res == ERROR_SUCCESS, "got %lu\n", res);
+    size = sizeof(buf);
+    ret = InternetGetCookieA("http://other.ex2.com/only/x", NULL, buf, &size);
+    ok(ret, "InternetGetCookie failed: %lu\n", GetLastError());
+    ok(!strcmp(buf, "B=two"), "data = %s\n", buf);
+    size = sizeof(buf);
+    ret = InternetGetCookieA("http://other.ex2.com/elsewhere", NULL, buf, &size);
+    ok(!ret && GetLastError() == ERROR_NO_MORE_ITEMS, "got %x (%lu)\n", ret, GetLastError());
+
+    /* a domain the url can't set is not stored */
+    cookie.pwszName = (WCHAR *)L"C";
+    cookie.pwszDomain = (WCHAR *)L"unrelated.com";
+    cookie.pwszPath = NULL;
+    state = 0xdeadbeef;
+    res = pInternetSetCookieEx2(L"http://cookie.ex2.com/", &cookie, NULL, 0, &state);
+    ok(res != ERROR_SUCCESS, "got %lu\n", res);
+    ok(state != COOKIE_STATE_ACCEPT, "state %lu\n", state);
+    size = sizeof(buf);
+    ret = InternetGetCookieA("http://unrelated.com/", NULL, buf, &size);
+    ok(!ret && GetLastError() == ERROR_NO_MORE_ITEMS, "got %x (%lu)\n", ret, GetLastError());
+
+    /* HTTP-only cookies are only returned with INTERNET_COOKIE_HTTPONLY */
+    cookie.pwszName = (WCHAR *)L"D";
+    cookie.pwszValue = (WCHAR *)L"four";
+    cookie.pwszDomain = NULL;
+    cookie.dwFlags = INTERNET_COOKIE_HTTPONLY;
+    res = pInternetSetCookieEx2(L"http://httponly.ex2.com/", &cookie, NULL, 0, NULL);
+    ok(res == ERROR_SUCCESS, "got %lu\n", res);
+    size = sizeof(buf);
+    ret = InternetGetCookieA("http://httponly.ex2.com/", NULL, buf, &size);
+    ok(!ret && GetLastError() == ERROR_NO_MORE_ITEMS, "got %x (%lu)\n", ret, GetLastError());
+    size = sizeof(buf);
+    ret = InternetGetCookieExA("http://httponly.ex2.com/", NULL, buf, &size, INTERNET_COOKIE_HTTPONLY, NULL);
+    ok(ret, "InternetGetCookieEx failed: %lu\n", GetLastError());
+    ok(!strcmp(buf, "D=four"), "data = %s\n", buf);
+
+    /* an expiry in the past deletes the cookie */
+    cookie.pwszName = (WCHAR *)L"A";
+    cookie.pwszValue = (WCHAR *)L"gone";
+    cookie.dwFlags = 0;
+    GetSystemTime(&st);
+    st.wYear -= 1;
+    SystemTimeToFileTime(&st, &cookie.ftExpires);
+    cookie.fExpiresSet = TRUE;
+    pInternetSetCookieEx2(L"http://cookie.ex2.com/bar", &cookie, NULL, 0, NULL);
+    size = sizeof(buf);
+    ret = InternetGetCookieA("http://cookie.ex2.com/bar", NULL, buf, &size);
+    ok(!ret && GetLastError() == ERROR_NO_MORE_ITEMS, "got %x (%lu) %s\n", ret, GetLastError(), buf);
+}
