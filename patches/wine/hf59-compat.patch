diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index bc71fe0..1c383e7 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1459,6 +1459,58 @@ static void free_tls_slot( LDR_DATA_TABLE_ENTRY *mod )
 }
 
 
+#ifdef __x86_64__
+/* Manual PE loaders use this internal Windows entry to register static TLS. */
+NTSTATUS WINAPI wine_handle_tls_data( LDR_DATA_TABLE_ENTRY *mod )
+{
+    const IMAGE_TLS_DIRECTORY *dir;
+    NTSTATUS status;
+    ULONG size;
+
+    if (!mod || !mod->DllBase) return STATUS_INVALID_PARAMETER;
+    if (!(dir = RtlImageDirectoryEntryToData( mod->DllBase, TRUE, IMAGE_DIRECTORY_ENTRY_TLS, &size )))
+        return STATUS_INVALID_IMAGE_FORMAT;
+    if (size < sizeof(*dir) || dir->EndAddressOfRawData < dir->StartAddressOfRawData ||
+        !dir->AddressOfIndex) return STATUS_INVALID_IMAGE_FORMAT;
+
+    RtlEnterCriticalSection( &loader_section );
+    status = alloc_tls_slot( mod ) ? STATUS_SUCCESS : STATUS_NO_MEMORY;
+    if (!status) mod->TlsIndex = -1;
+    RtlLeaveCriticalSection( &loader_section );
+    return status;
+}
+
+void WINAPI wine_release_tls_entry( LDR_DATA_TABLE_ENTRY *mod, ULONG flags )
+{
+    if (!mod || !mod->DllBase) return;
+    RtlEnterCriticalSection( &loader_section );
+    free_tls_slot( mod );
+    mod->TlsIndex = 0;
+    RtlLeaveCriticalSection( &loader_section );
+}
+
+/* shortcut: x64 private-loader discovery layout; revisit for other architectures. */
+__asm__( ".text\n"
+         ".balign 16,0xcc\n.fill 16,1,0xcc\n"
+         ".globl LdrpHandleTlsData\nLdrpHandleTlsData:\n"
+         "jmp wine_handle_tls_data\n"
+         ".balign 16,0xcc\n.fill 16,1,0xcc\n"
+         ".L_tls_discovery:\n"
+         "lea .L_tls_name(%rip),%rdx\nret\n"
+         ".balign 16,0xcc\n.fill 16,1,0xcc\n"
+         ".globl LdrpReleaseTlsEntry\nLdrpReleaseTlsEntry:\n"
+         "mov %rbx,8(%rsp)\npush %rdi\nsub $32,%rsp\n"
+         "mov %rdx,%rdi\nmov %rcx,%rbx\ntest %rdx,%rdx\n"
+         ".byte 0x75,0x0c\n.fill 12,1,0x90\n"
+         "call wine_release_tls_entry\n"
+         "mov 48(%rsp),%rbx\nadd $32,%rsp\npop %rdi\nret\n"
+         ".section .rdata,\"dr\"\n"
+         ".L_tls_name:\n.asciz \"LdrpHandleTlsData\"\n.balign 4\n"
+         ".rva LdrpHandleTlsData\n.long 0\n.rva .L_tls_discovery\n"
+         ".text\n" );
+#endif
+
