# Template: bin/install_units.sh replaces @SM4L_ROOT@ with this checkout's path and installs it as a systemd user unit.
[Unit]
Description=SM4L SpaceMouse bridge (loads the add-in into whichever CAD starts)
After=spacenavd.service

[Service]
ExecStart=/usr/bin/python3 -B "@SM4L_ROOT@/addin/spacemouse.py"
Restart=on-failure
RestartSec=30
# exit 2 = another bridge already holds the prefix lock
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
