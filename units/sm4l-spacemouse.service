[Unit]
Description=SM4L SpaceMouse bridge (loads the add-in into whichever CAD starts)
After=spacenavd.service

[Service]
ExecStart=/usr/bin/python3 -B %h/AI/System/Work-Laptop/apps/solidworks/SM4L/spacemouse.py
Restart=on-failure
RestartSec=30
# exit 2 = another bridge already holds the prefix lock
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
